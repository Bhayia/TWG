{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global website configuration, brand info, and SEO",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "tagline": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" },
        "announcement": { "type": "string" },
        "showAnnouncement": { "type": "boolean" },
        "heroVideoUrl": { "type": "string" },
        "heroPosterUrl": { "type": "string" }
      },
      "required": ["brandName", "tagline"]
    },
    "Event": {
      "title": "Event",
      "description": "Spiritual, residential, or travel programme event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "heroImage": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "location": { "type": "string" },
        "ticketPrice": { "type": "number" },
        "capacity": { "type": "number" },
        "bookedCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "slug", "ticketPrice"]
    },
    "Membership": {
      "title": "Membership Plan",
      "description": "Tiered annual or multi-year membership packages",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "duration": { "type": "string" },
        "price": { "type": "number" },
        "period": { "type": "string" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "price", "duration"]
    },
    "Product": {
      "title": "Store Product",
      "description": "Sacred rudraksha, perfume, or wellness item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string" },
        "stock": { "type": "number" },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "price", "category"]
    },
    "Journey": {
      "title": "Sacred Journey",
      "description": "Destination travel programme (India, Nepal, Malaysia)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "country": { "type": "string" },
        "duration": { "type": "string" },
        "route": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "price": { "type": "number" },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "country", "price"]
    },
    "Booking": {
      "title": "Event Booking",
      "description": "Confirmed booking for a spiritual programme",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "attendeeName": { "type": "string" },
        "attendeeEmail": { "type": "string", "format": "email" },
        "attendeePhone": { "type": "string" },
        "ticketCount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["eventId", "attendeeName", "attendeeEmail", "totalAmount"]
    },
    "Order": {
      "title": "Product Order",
      "description": "Purchase of store items",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerPhone": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "customerEmail", "totalAmount"]
    },
    "Inquiry": {
      "title": "Contact Inquiry",
      "description": "Inquiry or consultation request from visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered user / administrator record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/siteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global website settings and content"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Events and spiritual retreat programmes"
    },
    "/memberships/{membershipId}": {
      "schema": "Membership",
      "description": "Annual and multi-year membership packages"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Sacred store items"
    },
    "/journeys/{journeyId}": {
      "schema": "Journey",
      "description": "International and domestic sacred journey packages"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Attendee programme registrations"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Visitor consultation requests and contact messages"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered member and admin profiles"
    }
  }
}
